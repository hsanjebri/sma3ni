# Model. Empty = dev defaults: Whisper `small` (downloaded once from Hugging
# Face), DEVICE=cpu, COMPUTE_TYPE=int8. Production: the exported CTranslate2
# dir, e.g. MODEL_PATH=./models/whisper-darija-turbo-ct2, DEVICE=cuda,
# COMPUTE_TYPE=int8_float16.
MODEL_PATH=
MODEL_VERSION=dev
DEVICE=
COMPUTE_TYPE=
# Transcriptions running at once (the rest queue). Start with 1 per GPU.
ASR_CONCURRENCY=

# Limits
MAX_AUDIO_SECONDS=300
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_DAY=60

# Signs install tokens; changing it logs every install out (they re-install).
# Required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty (dev only) = a random key per process.
TOKEN_SECRET=

# Audio temp files: one req-* dir per request, deleted in `finally`.
# Empty = <system temp>/sma3ni-audio. A RAM-backed tmpfs keeps audio off disk.
AUDIO_TMP_DIR=

# LLM (summary / translation / replies)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Observability
SENTRY_DSN=

# Opt-in donations
DONATION_BUCKET=

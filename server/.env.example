# Model
MODEL_PATH=./models/whisper-darija-turbo-ct2
MODEL_VERSION=dev
DEVICE=cuda            # cuda | cpu
COMPUTE_TYPE=int8_float16

# Limits
MAX_AUDIO_SECONDS=300
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_DAY=60

# Audio temp files: one req-* dir per request, deleted in `finally`.
# Empty = <system temp>/sma3ni-audio. A RAM-backed tmpfs keeps audio off disk.
AUDIO_TMP_DIR=

# LLM (summary / translation / replies)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Observability
SENTRY_DSN=

# Opt-in donations
DONATION_BUCKET=
